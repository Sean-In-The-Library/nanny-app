OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4.1-mini

OPENAI_API_KEY=your_openai_key_here
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

APP_PASSWORD_SEAN=change_me
APP_PASSWORD_TINA=change_me
APP_PASSWORD_FAITH=change_me
APP_SESSION_SECRET=replace_with_a_long_random_secret

APP_PUBLIC_URL=https://nanny-app.aistudioprojects.com

# Recommended for real shared persistence on Vercel.
# Without these, Vercel can run the app but writes are only temporary.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
